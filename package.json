{
  "name": "hunger-desolate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:frontend": "node --experimental-strip-types --test src/lib/*.test.ts && node --test scripts/test-docker-install-ui.mjs scripts/test-instance-create-ui.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check": "npm run check:metadata && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "1.28.0",
    "@tauri-apps/api": "2.11.1",
    "reka-ui": "2.10.1",
    "vue": "3.5.38",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue-tsc": "2.2.12"
  }
}
